const fs = require('fs-extra');
const path = require('path');
const axios = require('axios');
const Logger = require('./logger');
const Recovery = require('./recovery');
const Classifier = require('./classifier');
const { Matcher } = require('./matcher');
const logger = new Logger();

// ============================================================
// স্মার্ট isAlive – শুধু স্ট্যাটাস না, কন্টেন্ট চেক করবে
// ============================================================
async function isAlive(url) {
    if (!url || typeof url !== 'string') return false;

    try {
        const headRes = await axios.head(url, {
            timeout: 8000,
            maxRedirects: 5,
            validateStatus: () => true,
            headers: { 
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
                'Accept': '*/*'
            }
        });

        if (headRes.status === 200 || headRes.status === 206) {
            const contentType = (headRes.headers['content-type'] || '').toLowerCase();
            const allowedTypes = [
                'video/', 'application/vnd.apple.mpegurl', 
                'audio/x-mpegurl', 'application/dash+xml',
                'application/x-mpegurl', 'application/mpegurl',
                'text/plain', 'application/octet-stream'
            ];
            if (allowedTypes.some(type => contentType.includes(type))) {
                return true;
            }
        }
    } catch {}

    try {
        const response = await axios.get(url, {
            timeout: 10000,
            maxRedirects: 5,
            responseType: 'stream',
            validateStatus: () => true,
            headers: { 
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
                'Accept': '*/*',
                'Range': 'bytes=0-1048576'
            }
        });

        if (response.status !== 200 && response.status !== 206 && response.status !== 416) {
            return false;
        }

        const contentType = (response.headers['content-type'] || '').toLowerCase();
        const allowedTypes = [
            'video/', 'application/vnd.apple.mpegurl', 
            'audio/x-mpegurl', 'application/dash+xml',
            'application/x-mpegurl', 'application/mpegurl',
            'text/plain', 'application/octet-stream'
        ];
        if (!allowedTypes.some(type => contentType.includes(type))) {
            return false;
        }

        if (contentType.includes('text/plain') || contentType.includes('application/octet-stream')) {
            const chunks = [];
            for await (const chunk of response.data) {
                chunks.push(chunk);
                if (Buffer.concat(chunks).length > 1024) break;
            }
            const buffer = Buffer.concat(chunks);
            const firstLine = buffer.toString('utf8', 0, Math.min(buffer.length, 1024));
            
            if (firstLine.includes('#EXTM3U') || 
                firstLine.includes('#EXTINF') ||
                firstLine.includes('<?xml') ||
                firstLine.includes('<MPD') ||
                firstLine.includes('ts') ||
                firstLine.includes('m3u8')) {
                return true;
            }
            return false;
        }

        return true;

    } catch (error) {
        return false;
    }
}

// ============================================================
// 1. Bonus Playlist Clear (জোরালো)
// ============================================================
function clearBonusPlaylist(outputPath) {
    try {
        if (fs.existsSync(outputPath)) {
            fs.unlinkSync(outputPath);
            logger.info(`🧹 Cleared bonus playlist: ${outputPath}`);
        } else {
            logger.info(`ℹ️ Bonus playlist not found, skipping clear.`);
        }
    } catch (err) {
        logger.error(`❌ Failed to clear bonus playlist: ${err.message}`);
        // ফাইল ডিলিট করতে না পারলেও থামব না
    }
}

// ============================================================
// 2. Main Playlist Generate
// ============================================================
function generateMainPlaylist(groups, groupOrder, outputPath) {
    try {
        let output = '#EXTM3U\n';
        for (const group of groupOrder) {
            const channels = groups[group] || [];
            if (channels.length === 0) continue;
            output += `# Group: ${group}\n`;
            for (const ch of channels) {
                output += ch.extinf + '\n';
                output += ch.url + '\n';
            }
        }
        fs.ensureDirSync(path.dirname(outputPath));
        fs.writeFileSync(outputPath, output, 'utf8');
        logger.success(`✅ Main playlist generated: ${outputPath}`);
    } catch (err) {
        logger.error(`❌ Failed to generate main playlist: ${err.message}`);
        throw err;
    }
}

// ============================================================
// 3. Bonus Playlist Generate – শুধু অনলাইন, এক গ্রুপ "Bonus"
// ============================================================
async function generateBonusPlaylist(allSourceChannels, usedSourceUrls, matchedGroupMap, outputPath) {
    try {
        const usedUrls = new Set(usedSourceUrls);
        const bonusCandidates = allSourceChannels.filter(ch => !usedUrls.has(ch.url));

        const onlineBonus = [];
        for (const ch of bonusCandidates) {
            if (await isAlive(ch.url)) {
                const newCh = { ...ch, group: 'Bonus' };
                onlineBonus.push(newCh);
            }
        }

        let output = '#EXTM3U\n';
        output += `# Group: Bonus\n`;
        for (const ch of onlineBonus) {
            output += ch.extinf + '\n';
            output += ch.url + '\n';
        }

        fs.ensureDirSync(path.dirname(outputPath));
        fs.writeFileSync(outputPath, output, 'utf8');
        logger.success(`✅ Bonus playlist generated: ${onlineBonus.length} online channels, single group "Bonus".`);
    } catch (err) {
        logger.error(`❌ Failed to generate bonus playlist: ${err.message}`);
        throw err;
    }
}

// ============================================================
// 4. Offline Channels Replace
// ============================================================
async function replaceOfflineChannels(mainChannels, combinedSourceChannels, foundChannels = []) {
    const stats = {
        replacedBySource: 0,
        replacedByToken: 0,
        removed: 0
    };
    const usedSourceUrls = [];
    const updatedMain = [];

    const matcher = new Matcher(null);

    for (const main of mainChannels) {
        const online = await isAlive(main.url);
        if (online) {
            updatedMain.push(main);
            continue;
        }

        logger.info(`🔍 Searching replacement for: ${main.name}`);
        const candidates = matcher.findMatch(main, combinedSourceChannels);
        let replaced = false;

        for (const candidate of candidates) {
            if (await isAlive(candidate.url)) {
                const newChannel = { ...main };
                newChannel.url = candidate.url;
                newChannel.name = candidate.name;
                newChannel.tvgId = candidate.tvgId || main.tvgId;
                newChannel.tvgName = candidate.tvgName || main.tvgName;
                newChannel.logo = candidate.logo || main.logo;
                newChannel.extinf = candidate.extinf || main.extinf;
                updatedMain.push(newChannel);
                usedSourceUrls.push(candidate.url);
                stats.replacedBySource++;
                logger.success(`🔄 Replaced: ${main.name} -> ${candidate.name}`);
                replaced = true;
                break;
            }
        }

        if (!replaced) {
            updatedMain.push(main);
            stats.removed++;
            logger.warning(`❌ No replacement found for: ${main.name}, keeping old URL`);
        }
    }

    return { playlist: updatedMain, stats, usedSourceUrls };
}

// ============================================================
// 5. New Channels Add
// ============================================================
async function addNewChannelsToMain(updatedMainChannels, allSourceChannels, groupLearner, usedSourceUrls) {
    const added = [];
    const matchedGroupMap = {};

    const mainNames = new Set(updatedMainChannels.map(ch => ch.name.toLowerCase().trim()));
    const candidates = allSourceChannels.filter(ch => {
        const name = ch.name.toLowerCase().trim();
        return !mainNames.has(name) && !usedSourceUrls.includes(ch.url);
    });

    if (candidates.length === 0) {
        logger.info('ℹ️ No new channels to add.');
        return { added, matchedGroupMap };
    }

    const classifier = new Classifier(groupLearner, 0.7);
    const result = await classifier.classify(candidates, groupLearner.getGroups());

    for (const ch of result.assignedToMain) {
        added.push(ch);
        if (!matchedGroupMap[ch.group]) matchedGroupMap[ch.group] = [];
        matchedGroupMap[ch.group].push(ch);
    }

    logger.info(`🧩 Added ${added.length} new channels to main.`);
    return { added, matchedGroupMap };
}

// ============================================================
// 6. Restore Original
// ============================================================
async function checkAndRestoreOriginal(mainChannels) {
    const restored = [];
    for (const ch of mainChannels) {
        const key = Recovery.getKey(ch.name);
        const state = Recovery.loadState();
        if (state.channels[key] && state.channels[key].status === 'replaced') {
            const original = state.channels[key].original;
            if (original && original.url) {
                if (await isAlive(original.url)) {
                    ch.url = original.url;
                    ch.extinf = original.extinf || ch.extinf;
                    Recovery.restore(ch.name);
                    restored.push(ch);
                    logger.success(`♻️ Restored original: ${ch.name}`);
                }
            }
        }
    }
    return restored;
}

// ============================================================
// 7. পুরানো updatePlaylist (ব্যাকওয়ার্ড কম্প্যাটিবিলিটি)
// ============================================================
async function updatePlaylist(mainChannels, sourceChannels) {
    let output = "#EXTM3U\n";
    let updated = 0, unchanged = 0, failed = 0;

    for (const main of mainChannels) {
        let finalUrl = main.url;
        if (await isAlive(main.url)) {
            unchanged++;
            output += main.extinf + "\n" + finalUrl + "\n";
            continue;
        }
        const matcher = new Matcher(null);
        const candidates = matcher.findMatch(main, sourceChannels);
        let replaced = false;
        for (const candidate of candidates.slice(0, 5)) {
            if (await isAlive(candidate.url)) {
                finalUrl = candidate.url;
                updated++;
                replaced = true;
                break;
            }
        }
        if (!replaced) failed++;
        output += main.extinf + "\n" + finalUrl + "\n";
    }
    return output;
}

// ============================================================
// 8. সব ফাংশন এক্সপোর্ট
// ============================================================
module.exports = {
    clearBonusPlaylist,
    generateMainPlaylist,
    generateBonusPlaylist,
    replaceOfflineChannels,
    addNewChannelsToMain,
    checkAndRestoreOriginal,
    updatePlaylist,
    isAlive
};